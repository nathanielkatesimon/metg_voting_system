# MongoDB connection string (e.g. mongodb://localhost:27017/voting_system)
MONGO_URI=mongodb://localhost:27017/voting_system

# Secret used to sign session cookies — use a long random string in production
SESSION_SECRET=change_me_to_a_long_random_secret

# Port the Express server listens on
PORT=5000

# "development" or "production" — controls cookie secure flag and error detail
NODE_ENV=development

# Full URL of the React client (used for CORS origin)
CLIENT_URL=http://localhost:5173
